# =========================================================
# Cloudflare R2 - photo & video storage
# =========================================================
# Cloudflare dashboard -> R2 -> create two buckets:
#   rudra-media     (public: website photos + videos)
#   rudra-archive   (private: full-resolution originals, never made public)
# R2 -> Manage R2 API Tokens -> create a token with "Object Read & Write" on both buckets.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=rudra-media
R2_ARCHIVE_BUCKET=rudra-archive

# Public address of the rudra-media bucket (custom domain, or the r2.dev URL for testing).
# Leave empty during local development to use the files in media/.
VITE_MEDIA_BASE_URL=https://media.yourdomain.com

# =========================================================
# Google Reviews (shown on the homepage). Pick ONE option:
# =========================================================
# Option A (easiest, third-party widget): create a free "Google Reviews" widget at https://elfsight.com,
#   connect your Google Business listing, then paste the widget's App ID (the part after "elfsight-app-"):
VITE_ELFSIGHT_APP_ID=ce1aabd5-98c4-4dc3-80ab-68578237753f
#
# Option B (Google's own API, up to 5 reviews): enable "Places API (New)" in Google Cloud Console, create
#   an API key restricted to your website's domain, and find your Place ID at
#   https://developers.google.com/maps/documentation/places/web-service/place-id
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
#
# Option C (no account needed): copy real reviews from Google into src/data/googleReviews.js
